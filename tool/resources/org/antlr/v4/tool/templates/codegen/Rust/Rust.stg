RustTypeMap ::= [
	"int":"i32",
	"string":"String",
	default : key
]
rustTypeInitMap ::= [
	"int":"0",
	"long":"0",
	"float":"0.0f",
	"double":"0.0",
	"boolean":"false",
	"byte":"0",
	"short":"0",
	"char":"0",
	"String":"String::new()",
 	"Vec<String>":"Vec::new()",
	default:"null" // anything other than a primitive type is an object
]

// args must be <object-model-object>, <fields-resulting-in-STs>

ParserFile(file, parser, namedActions, contextSuperClass) ::= <<
<fileHeader(file.grammarFileName, file.ANTLRVersion)>
#![allow(dead_code)]
#![allow(unused_imports)]
#![allow(non_snake_case)]
#![allow(non_upper_case_globals)]
#![allow(nonstandard_style)]
#![allow(unused_braces)]
#![allow(unused_parens)]
<namedActions.header>
use dbt_antlr4::Arena;
use dbt_antlr4::PredictionContextCache;
use dbt_antlr4::parser::{Parser, BaseParser, ParserRecog, ListenerId};
use dbt_antlr4::token::CommonToken;
use dbt_antlr4::token_stream::TokenStream;
use dbt_antlr4::TokenSource;
use dbt_antlr4::parser_atn_simulator::ParserATNSimulator;
use dbt_antlr4::errors::ANTLRError;
use dbt_antlr4::rule_context::{CustomRuleContext, RuleContext};
use dbt_antlr4::recognizer::{Recognizer,Actions};
use dbt_antlr4::atn_config_set::ATNConfigSet;
use dbt_antlr4::atn_deserializer::ATNDeserializer;
use dbt_antlr4::atn_simulator::BaseATNSimulator;
use dbt_antlr4::atn_simulator::ParserATNSimulatorManager as ATNSimulatorManager;
use dbt_antlr4::atn::{ATN, INVALID_ALT};
use dbt_antlr4::error_strategy::{DefaultErrorStrategy, ErrorStrategyDelegate, ErrorStrategy};
use dbt_antlr4::parser_rule_context::{BaseParserRuleContext, ParserRuleContext};
use dbt_antlr4::tree::*;
use dbt_antlr4::token::{TOKEN_EOF,Token};
use dbt_antlr4::int_stream::EOF;
use dbt_antlr4::vocabulary::{Vocabulary,VocabularyImpl};
use dbt_antlr4::token_factory::TokenFactory;
<if(file.genListener)>
use super::<file.grammarName; format="lower">listener::*;
<endif>
<if(file.genVisitor)>
use super::<file.grammarName; format="lower">visitor::*;
<endif>

use std::marker::PhantomData;
use std::sync::LazyLock;
use std::rc::Rc;
use std::ops::{DerefMut, Deref};

<parser>
>>

ListenerFile(file, header, namedActions) ::= <<
#![allow(nonstandard_style)]
<fileHeader(file.grammarFileName, file.ANTLRVersion)>
<header>
use dbt_antlr4::errors::ANTLRError;
use dbt_antlr4::token::{CommonToken, Token};
use dbt_antlr4::tree::ParseTreeListener;
use super::<file.parserName; format="lower">::*;

pub trait <file.grammarName>Listener\<'arena, Tok = CommonToken\<'arena>\> : ParseTreeListener\<'arena, <file.parserName>NodeKind, Tok>
where
    Tok: Token + 'arena,
{
<file.listenerNames:{lname |
    <if(file.listenerLabelRuleNames.(lname))>
    /// Enter a parse tree produced by the {@code <lname>\}
    /// labeled alternative in {@link <file.parserName>#<file.listenerLabelRuleNames.(lname)>\}.
    <else>
    /// Enter a parse tree produced by {@link <file.parserName>#<lname>\}.
    <endif>
    /// @param ctx the parse tree
    fn enter_<lname>\<'input: 'arena>(&mut self, _ctx: &<lname; format="cap">Context\<'input, 'arena, Tok>) -> Result\<(), ANTLRError> { Ok(()) \}

    <if(file.listenerLabelRuleNames.(lname))>
    /// Exit a parse tree produced by the {@code <lname>\}
    /// labeled alternative in {@link <file.parserName>#<file.listenerLabelRuleNames.(lname)>\}.
    <else>
    /// Exit a parse tree produced by {@link <file.parserName>#<lname>\}.
    <endif>
    /// @param ctx the parse tree
    fn exit_<lname>\<'input: 'arena>(&mut self, _ctx: &<lname; format="cap">Context\<'input, 'arena, Tok>) -> Result\<(), ANTLRError> { Ok(()) \}
}; separator="\n">
}

>>

BaseListenerFile(file, header, namedActions) ::= <<
<fileHeader(file.grammarFileName, file.ANTLRVersion)>

<if(header)>

<header>
<endif>

use super::<file.parserName; format="lower">::*;
use dbt_antlr4::tree::ParseTreeListener;

// A complete Visitor for a parse tree produced by <file.parserName>.

pub trait <file.grammarName>BaseListener\<'arena>:
    ParseTreeListener\<'arena, <file.parserName>NodeKind> {

<file.listenerNames:{lname |
    /**
     * Enter a parse tree produced by \{@link <file.grammarName>BaseParser#s\}.
     * @param ctx the parse tree
,      */
    fn enter_<lname; format="lower">(&mut self, _ctx: &<lname; format="cap">Context\<'input, 'arena>) {\}
    /**
     * Exit a parse tree produced by \{@link  <file.grammarName>BaseParser#s\}.
     * @param ctx the parse tree
     */
    fn exit_<lname; format="lower">(&mut self, _ctx: &<lname; format="cap">Context\<'input, 'arena>) {\}

}; separator="\n">
}
>>

VisitorFile(file, header, namedActions) ::= <<
#![allow(nonstandard_style)]
#![allow(dead_code)]
<fileHeader(file.grammarFileName, file.ANTLRVersion)>
<header>
use dbt_antlr4::token::{CommonToken, Token};
use dbt_antlr4::errors::ANTLRError;
use dbt_antlr4::tree::*;
use super::<file.parserName; format="lower">::*;

/// This interface defines a complete generic visitor for a parse tree produced
/// by {@link <file.parserName>}.
pub trait <file.grammarName>Visitor\<'input, 'arena, Tok = CommonToken\<'input\>\>
where
    'input: 'arena,
    Tok: Token + 'input,
{
    type Return: Default;

<file.visitorNames:{lname |
    <if(file.visitorLabelRuleNames.(lname))>
    /// Visit a parse tree produced by the {@code <lname>\}
    /// labeled alternative in {@link <file.parserName>#<file.visitorLabelRuleNames.(lname)>\}.
    <else>
    /// Visit a parse tree produced by {@link <file.parserName>#<lname>\}.
    <endif>
    /// @param ctx the parse tree
    fn visit_<lname>(&mut self, ctx: &'arena <lname; format="cap">Context\<'input, 'arena, Tok>) -> Result\<Self::Return, ANTLRError> { self.visit_children(ctx) \}
}; separator="\n">

    /// Called on terminal(leaf) node
    fn visit_terminal(
        &mut self,
        _node: &'arena TerminalNode\<'input, 'arena, Tok>,
    ) -> Result\<Self::Return, ANTLRError> { Ok(Self::Return::default()) }

    /// Called on error node
    fn visit_error_node(
        &mut self,
        _node: &'arena ErrorNode\<'input, 'arena, Tok>,
    ) -> Result\<Self::Return, ANTLRError> { Ok(Self::Return::default()) }

    fn visit(&mut self, tree: &'arena dyn NodeInner\<'input, 'arena, <file.parserName>NodeKind, Tok>) -> Result\<Self::Return, ANTLRError> {
        self.visit_node(tree.as_node())
    }

    fn visit_node(&mut self, node: &'arena <file.parserName>Node\<'input, 'arena, Tok>) -> Result\<Self::Return, ANTLRError> {
        node.accept(self)
    }

    fn visit_children(
        &mut self,
        node: &'arena dyn NodeInner\<'input, 'arena, <file.parserName>NodeKind, Tok>,
    ) -> Result\<Self::Return, ANTLRError> {
        let mut result = Self::Return::default();
        for child in node.iter_child_nodes() {
            if !self.should_visit_next_child(child, &result) {
                break;
            }

            let child_result = self.visit_node(child)?;
            result = self.aggregate_results(result, child_result)?;
        }
        Ok(result)
    }

    fn aggregate_results(
        &self,
        _aggregate: Self::Return,
        next: Self::Return,
    ) -> Result\<Self::Return, ANTLRError> { Ok(next) }

    fn should_visit_next_child(&self, _node: &'arena <file.parserName>Node\<'input, 'arena, Tok>, _current: &Self::Return) -> bool { true }
}
>>

// no need for base visitor
BaseVisitorFile(file, header, namedActions) ::= <<
<fileHeader(file.grammarFileName, file.ANTLRVersion)>
>>

fileHeader(grammarFileName, ANTLRVersion) ::= <<
// Generated from <grammarFileName> by ANTLR <ANTLRVersion>
>>

Parser(parser, funcs, atn, sempredFuncs, superClass) ::= <<
dbt_antlr4::check_version!("1","3");
<if(parser.tokens)>
<parser.tokens:{k | pub const <parser.grammarName>_<k>:i32=<parser.tokens.(k)>;}; separator=" \n">
<endif>
pub const <parser.grammarName>_EOF:i32=EOF;
<parser.rules:{r | pub const RULE_<r.name>:usize = <r.index>;}; separator=" \n">
pub const ruleNames: [&'static str; <length(parser.ruleNames)>] = [
    <parser.ruleNames:{r | "<r>"}; separator=", ", wrap, anchor>
];

<vocabulary(parser.literalNames, parser.symbolicNames)>
<namedActions.definitions>

pub type BaseParserType\<'input, 'arena, Input, TF> = BaseParser\<'input, 'arena, <parser.name>Ext\<'input, 'arena>, <parser.name>NodeKind, Input, TF>;
pub fn parser_simulator_manager() -> &'static ATNSimulatorManager { &ATN_SIMULATOR_MANAGER }

pub struct <parser.name>\<'input, 'arena, Input, TF>
where
    'input: 'arena,
    TF: TokenFactory\<'input, 'arena\> + 'arena,
    Input: TokenStream\<'input, 'arena, TF> + 'arena,
{
	base: BaseParserType\<'input, 'arena, Input, TF>,
    err_handler: ErrorStrategyDelegate\<'input, 'arena, TF, BaseParserType\<'input, 'arena, Input, TF>\>,
}

impl\<'input, 'arena, Input, TF> <parser.name>\<'input, 'arena, Input, TF>
where
    'input: 'arena,
    TF: TokenFactory\<'input, 'arena\> + 'arena,
    Input: TokenStream\<'input, 'arena, TF> + 'arena,
{
    pub fn with_strategy(arena: &'arena Arena, input: Input, strategy: Box\<dyn ErrorStrategy\<'input, 'arena, TF, BaseParserType\<'input, 'arena, Input, TF>\> + 'arena>) -> Self {
		Self {
			base: BaseParser::new_base_parser(
				arena, input,
				<parser.name>Ext {
					_pd: Default::default(),
					<namedActions.init>
				}
			),
            err_handler: unsafe { ErrorStrategyDelegate::new(strategy) },
        }
    }

    pub fn new(arena: &'arena Arena, input: Input) -> Self{
    	Self::with_strategy(arena, input, Box::new(DefaultErrorStrategy::new()))
    }

    pub fn set_error_strategy(&mut self, strategy: Box\<dyn ErrorStrategy\<'input, 'arena, TF, BaseParserType\<'input, 'arena, Input, TF>\> + 'arena>) {
        self.err_handler = unsafe { ErrorStrategyDelegate::new(strategy) };
    }

    /// Adds parse listener for this parser
    /// returns `listener_id` that can be used later to get listener back
    ///
    /// ### Example for listener usage:
    /// todo
    pub fn add_parse_listener\<L>(
        &mut self,
        listener: Box\<L>,
    ) -> ListenerId\<L>
    where
        L: <if(file.genListener)><parser.grammarName>Listener\<'arena, TF::Tok><else>ParseTreeListener\<'arena, <parser.name>NodeKind, TF::Tok><endif> + 'static,
    {
        let id = ListenerId::new(&listener);
        self.base.add_dyn_parse_listener(listener);
        id
    }
}
<if(file.genVisitor)>
pub trait Visitable\<'input: 'arena, 'arena, Tok: Token + 'input> {
    fn accept\<V>(&'arena self, visitor: &mut V) -> Result\<V::Return, ANTLRError>
    where
        'input: 'arena,
        V: <file.grammarName>Visitor\<'input, 'arena, Tok> + ?Sized;
}
<endif>
pub struct <file.grammarName>TreeWalker;
impl <file.grammarName>TreeWalker
{
    pub fn walk\<'input, 'arena, Tok, L, T\>(
        listener: Box\<L\>,
        tree: &'arena T,
    ) -> Result\<Box\<L\>, ANTLRError>
    where
        'input: 'arena,
        L: <if(file.genListener)><parser.grammarName>Listener\<'arena, Tok><else>ParseTreeListener\<'arena, <parser.name>NodeKind, Tok><endif> + 'static,
        T: NodeInner\<'input, 'arena, <parser.name>NodeKind, Tok\>,
        Tok: Token + 'input,
    {
        let listener_ptr = Box::into_raw(listener);
        let listener = unsafe { Box::from_raw(listener_ptr as *mut \<<parser.name>NodeKind as NodeKindType\<Tok>\>::Listener) };
        let listener = ParseTreeWalker::walk(listener, tree.as_node())?;
        Ok(unsafe { Box::from_raw(Box::into_raw(listener) as *mut L) } )
    }
}

#[derive(Clone, Copy, PartialEq, Eq, Debug)]
#[repr(u16)]
pub enum <parser.name>NodeKind {
    <parser.funcs:{f | <f.ruleCtx:{r | <r.name>,
    }>}>    Terminal,
    Error,
}
pub type <parser.name>Node\<'input, 'arena, Tok = CommonToken\<'input\>\> = TreeNode\<'input, 'arena, <parser.name>NodeKind, Tok\>;

dbt_antlr4::impl_deref! { parser => <parser.name> }
dbt_antlr4::impl_node_kind! { <parser.name>NodeKind {
    <parser.funcs:{f | <f.ruleCtx:{r | <if(r.provideCopyFrom)><r.escapedName>(<r.escapedName>All), <endif>}>}>; <parser.funcs:{f | <f.ruleCtx:{r | <if(!r.provideCopyFrom)><r.escapedName>(<if(file.genListener)>enter_<r.derivedFromName>, exit_<r.derivedFromName>, <endif><if(file.genVisitor)> visit_<r.derivedFromName><endif>), <endif>}>}>
    }; <if(file.genListener)>listener = dyn <parser.grammarName>Listener\<'arena, Tok>,<endif><if(file.genVisitor)> visitor = <parser.grammarName>Visitor,<endif>
}

pub struct <parser.name>Ext\<'input, 'arena> {
	_pd: PhantomData\<(&'input str, &'arena ())>,
	<namedActions.fields>
}

impl\<'input, 'arena> <parser.name>Ext\<'input, 'arena> {
	<namedActions.members>
}

impl\<'input, 'arena, Input, TF\> ParserRecog\<'input, 'arena, BaseParserType\<'input, 'arena, Input, TF>, TF::Tok\> for <parser.name>Ext\<'input, 'arena>
where
    'input: 'arena,
    TF: TokenFactory\<'input, 'arena> + 'arena,
    Input: TokenStream\<'input, 'arena, TF> + 'arena {
    fn get_atn_simulator_man(&self) -> &'static ATNSimulatorManager { &ATN_SIMULATOR_MANAGER }        
}

impl\<'input, 'arena, Input, TF\> Actions\<'input, 'arena, BaseParserType\<'input, 'arena, Input, TF>, TF::Tok\> for <parser.name>Ext\<'input, 'arena>
where
    'input: 'arena,
    TF: TokenFactory\<'input, 'arena> + 'arena,
    Input: TokenStream\<'input, 'arena, TF> + 'arena,
{
	fn get_grammar_file_name(&self) -> & str{ "<parser.grammarFileName>" }
   	fn get_rule_names(&self) -> &[& str] { &ruleNames }
   	fn get_vocabulary(&self) -> &dyn Vocabulary { &**VOCABULARY }
<if(sempredFuncs)>
	fn sempred(_localctx: Option\<&'arena <parser.name>Node\<'input, 'arena, TF::Tok\>\>, rule_index: i32, pred_index: i32,
			   recog:&mut BaseParserType\<'input, 'arena, Input, TF>
	) -> bool {
		match rule_index {
		    <parser.sempredFuncs.values:{f| <f.ruleIndex> => <parser.name>::\<'input, 'arena, Input, TF>::<f.escapedName>_sempred(_localctx.and_then(|x| x.as_rule_context()), pred_index, recog),}; separator="\n">
			_ => true
		}
	}
}

impl\<'input, 'arena, Input, TF> <parser.name>\<'input, 'arena, Input, TF>
where
    'input: 'arena,
    TF: TokenFactory\<'input, 'arena> + 'arena,
    Input: TokenStream\<'input, 'arena, TF> + 'arena,
{
	<sempredFuncs.values; separator="\n">
<endif>
}
<funcs; separator="\n">

<atn>
>>

vocabulary(literalNames, symbolicNames) ::= <<
pub const _LITERAL_NAMES: [Option\<&'static str>;<length(literalNames)>] = [
	<literalNames:{t | Some(<t>)}; null="None", separator=", ", wrap, anchor>
];
pub const _SYMBOLIC_NAMES: [Option\<&'static str>;<length(symbolicNames)>]  = [
	<symbolicNames:{t | Some(<t>)}; null="None", separator=", ", wrap, anchor>
];

static VOCABULARY: LazyLock\<Box\<dyn Vocabulary>\> = LazyLock::new(|| Box::new(VocabularyImpl::new(_LITERAL_NAMES.iter(), _SYMBOLIC_NAMES.iter(), None)));
>>

dumpLexerActions(recog, argFuncs, actionFuncs, sempredFuncs) ::= <<
{
<if(actionFuncs)>
    fn action(_localctx: Option\<&EmptyRuleNode\<'input, 'arena, TF::Tok\>\>, rule_index: i32, action_index: i32, recog:&mut BaseLexerType\<'input, 'arena, Input, TF>) {
        match rule_index {
<recog.actionFuncs.values:{f|
            <f.ruleIndex> => <recog.name>Actions::<f.escapedName>_action(action_index, recog), }; separator="\n">
            _ => {}
        }
    }
<endif>
<if(sempredFuncs)>
    fn sempred(_localctx: Option\<&EmptyRuleNode\<'input, 'arena, TF::Tok\>\>, rule_index: i32, pred_index: i32, recog:&mut BaseLexerType\<'input, 'arena, Input, TF>) -> bool {
        match rule_index {
<recog.sempredFuncs.values:{f|
            <f.ruleIndex> => <recog.name>Actions::<f.escapedName>_sempred(pred_index, recog), }; separator="\n">
            _ => true
        }
    }
<endif>
}
>>

parser_ctor(p) ::= << >>

RuleActionFunction(r, actions) ::= <<
fn <r.escapedName>_action\<'input, 'arena, Input, TF>(action_index: i32, recog: &mut BaseLexerType\<'input, 'arena, Input, TF>)
where
    TF: TokenFactory\<'input, 'arena> + 'arena,
    Input: CharStream\<'input>,
{
	match action_index {
<actions:{index|
        <index> => {
		<actions.(index)>
        \},}; separator="\n">
		_ => {}
	}
}
>>

RuleSempredFunction(r, actions) ::= <<
<! Called for both lexer and parser. But only one of them is actually available. Testing for the parser directly
   generates a warning, however. So do the check via the factory instead. !>
<if(r.factory.g.lexer)>
fn <r.escapedName>_sempred\<'arena, 'input, Input, TF>(pred_index:i32, recog: &mut BaseLexerType\<'input, 'arena, Input, TF>) -> bool
where
    TF: TokenFactory\<'input, 'arena> + 'arena,
    Input: CharStream\<'input>,
<else>
fn <r.escapedName>_sempred(_ctx: Option\<&'arena <r.ctxType>\<'input, 'arena, TF::Tok\>\>, pred_index:i32, recog: &mut \<Self as Deref>::Target) -> bool
<endif> {
	match pred_index {
<actions:{index|
        <index> => {
		<actions.(index)>
	    \}}; separator="\n">
	    _ => true
	}
}
>>

RuleTypeForAlt(currentRule,ruleCtx,altLabelCtxs) ::= <<
<if(ruleCtx.struct.provideCopyFrom)>
#[derive(Debug)]
#[repr(C, u16)]
pub enum <currentRule.ctxType>All\<'input, 'arena, Tok = CommonToken\<'input\>\>
where
    'input: 'arena,
    Tok: Token + 'input,
{
	<altLabelCtxs:{l | <altLabelCtxs.(l).struct.escapedName>(<altLabelCtxs.(l).struct.escapedName>\<'input, 'arena, Tok>),
	}>    Error(<ruleCtx.struct.escapedName>\<'input, 'arena, Tok>)
}

dbt_antlr4::impl_rule_context! { <currentRule.ctxType>All { } { <altLabelCtxs:{l | <altLabelCtxs.(l).struct.escapedName>, }>Error, } }
dbt_antlr4::impl_parser_rule_context! { <currentRule.ctxType>All { } { <altLabelCtxs:{l | <altLabelCtxs.(l).struct.escapedName>, }>Error, } }
dbt_antlr4::impl_tree_trait_delegates! { <parser.name>NodeKind::<currentRule.ctxType>All { <altLabelCtxs:{l | <altLabelCtxs.(l).struct.escapedName>, }>Error, } }
dbt_antlr4::impl_node_inner! { <parser.name>NodeKind::<currentRule.ctxType>::<currentRule.ctxType>All { <altLabelCtxs:{l | <altLabelCtxs.(l).struct.escapedName>, }>Error, } }
<if(file.genListener)>dbt_antlr4::impl_listener_dispatch! { <parser.grammarName>Listener::<parser.name>NodeKind::<currentRule.ctxType>All { <altLabelCtxs:{l | <altLabelCtxs.(l).struct.escapedName>(enter_<altLabelCtxs.(l).struct.derivedFromName>, exit_<altLabelCtxs.(l).struct.derivedFromName>), }>} }<endif>
<if(file.genVisitor)>dbt_antlr4::impl_visitable! { <parser.grammarName>Visitor::<currentRule.ctxType>All { <altLabelCtxs:{l | <altLabelCtxs.(l).struct.escapedName>(visit_<altLabelCtxs.(l).struct.derivedFromName>), }>} }<endif>

impl\<'input, 'arena, Tok> Deref for <currentRule.ctxType>All\<'input, 'arena, Tok>
where
    'input: 'arena,
    Tok: Token + 'input,
{
	type Target = dyn <currentRule.ctxType>Attrs\<'input, 'arena, Tok> + 'arena;
	fn deref(&self) -> &Self::Target{
		use <currentRule.ctxType>All::*;
		match self{
			<altLabelCtxs:{l | <altLabelCtxs.(l).struct.escapedName>(inner) => inner,}; separator="\n">
            Error(inner) => inner
		}
	}
}
<else>
pub type <currentRule.ctxType>All\<'input, 'arena, Tok = CommonToken\<'input\>\> = <ruleCtx.struct.escapedName>\<'input, 'arena, Tok>;
<endif>
>>

RuleFunction(currentRule,args,code,locals,ruleCtx,altLabelCtxs,namedActions,finallyAction,postamble,exceptions) ::= <<
//------------------- <currentRule.name> ----------------
<RuleTypeForAlt(currentRule,ruleCtx,altLabelCtxs)>
<ruleCtx>
<altLabelCtxs:{l | <altLabelCtxs.(l)>}; separator="\n">

impl\<'input, 'arena, Input, TF> <parser.name>\<'input, 'arena, Input, TF\>
where
    'input: 'arena,
    TF: TokenFactory\<'input, 'arena\> + 'arena,
    Input: TokenStream\<'input, 'arena, TF> + 'arena,
{
	<if(currentRule.modifiers)><currentRule.modifiers:{f | <f> }><else>pub <endif>fn <currentRule.escapedName>(&mut self,<args; separator=",">) -> Result\<&'arena <currentRule.ctxType>All\<'input, 'arena, TF::Tok>, ANTLRError> {
        dbt_antlr4::maybe_grow_stack!({
		let recog = self;
        let _parentctx = <self()>.base.take_ctx();
        <self()>.base.enter_rule(<currentRule.ctxType>Ext::create(<self()>.get_arena(), _parentctx, <self()>.get_state()<currentRule.args:{a | , <a.escapedName>}>)?, <currentRule.startState>, RULE_<currentRule.name>)?;
        let _local_ctx_fn = |recog: &Self| -> &'arena <currentRule.ctxType>\<TF::Tok> {recog.ctx().unwrap().as_rule_context().unwrap()};
		<namedActions.init>
		<locals; separator="\n">
		let result: Result\<(), ANTLRError> = (|| {
	        <if(currentRule.hasLookaheadBlock)>let mut _alt: i32;<endif>
			<code>
            <postamble; separator="\n"><namedActions.after>
			Ok(())
		})();
		match result {
            Ok(_)=>{},
            <if(exceptions)><exceptions; separator="\n"><endif>
            Err(e) if !e.is_recoverable() => return Err(e),
            Err(ref re) => {
				<self()>.err_handler.report_error(&mut <self()>.base, re);
				<self()>.err_handler.recover(&mut <self()>.base, re)?;
			}
		}
		<finallyAction>
		<self()>.base.exit_rule().map(|ctx: &'arena _| { ctx.as_rule_context().unwrap() })
        })
	}
}
>>

LeftRecursiveRuleFunction(currentRule,args,code,locals,ruleCtx,altLabelCtxs,
	namedActions,finallyAction,postamble,exceptions) ::=
<<//------------------- <currentRule.name> ----------------
<RuleTypeForAlt(currentRule,ruleCtx,altLabelCtxs)>
<ruleCtx>
<altLabelCtxs:{l | <altLabelCtxs.(l)>}; separator="\n">

impl\<'input, 'arena, Input, TF> <parser.name>\<'input, 'arena, Input, TF\>
where
    'input: 'arena,
    TF: TokenFactory\<'input, 'arena\> + 'arena,
    Input: TokenStream\<'input, 'arena, TF> + 'arena,
{
    #[inline]
	<if(currentRule.modifiers)><currentRule.modifiers:{f | <f> }><else>pub fn <endif> <currentRule.escapedName>(&mut self,<args; separator=", ">) -> Result\<&'arena <currentRule.ctxType>All\<'input, 'arena, TF::Tok\>, ANTLRError> {
		self.<currentRule.escapedName>_rec(0<currentRule.args:{a | , <a.escapedName>}>)
	}

	fn <currentRule.escapedName>_rec(&mut self, _p: i32<args:{a | , <a>}>) -> Result\<&'arena <currentRule.ctxType>All\<'input, 'arena, TF::Tok\>, ANTLRError> {
        dbt_antlr4::maybe_grow_stack!({
		let recog = self;
		let _parentctx = <self()>.base.take_ctx();
		let _parentState = <self()>.base.get_state();
		<self()>.base.enter_recursion_rule(<currentRule.ctxType>Ext::create(<self()>.get_arena(), _parentctx, <self()>.get_state()<currentRule.args:{a | , <a.escapedName>}>)?, <currentRule.startState>, RULE_<currentRule.name>, _p)?;
        let _local_ctx_fn = |recog: &Self| -> &'arena <currentRule.ctxType>\<TF::Tok> {recog.ctx().unwrap().as_rule_context().unwrap()};
		let _startState = <currentRule.startState>;
		<namedActions.init>
		<locals; separator="\n">
		let result: Result\<(), ANTLRError> = (|| {
	        <if(currentRule.hasLookaheadBlock)>let mut _alt: i32;<endif>
			<code>
			<postamble; separator="\n">
			<namedActions.after>
			Ok(())
		})();
		match result {
		Ok(_) => {},
		<if(exceptions)>
        <exceptions; separator="\n">
        <endif>
        Err(e) if !e.is_recoverable() => return Err(e),
		Err(ref re)=>{
			<self()>.err_handler.report_error(&mut <self()>.base, re);
	        <self()>.err_handler.recover(&mut <self()>.base, re)?;}
		}
		<finallyAction>
		<self()>.base.unroll_recursion_context(_parentctx).map(|ctx| { ctx.as_rule_context().unwrap() } )
        })
	}
}
>>

CodeBlockForOuterMostAlt(currentOuterMostAltCodeBlock, locals, preamble, ops) ::= <<
/*------- Outer Most Alt <currentOuterMostAltCodeBlock.alt.altNum> -------*/
<if(currentOuterMostAltCodeBlock.altLabel)>
<self()>.base.with_mut_ctx(|ctx| {
    <currentOuterMostAltCodeBlock.altLabel; format="cap">ContextExt::copy_from(ctx);
    ctx.set_alt_number(<currentOuterMostAltCodeBlock.alt.altNum>);
});
let _local_ctx_fn = |recog: &Self| -> &'arena <currentOuterMostAltCodeBlock.altLabel; format="cap">Context\<TF::Tok> {recog.ctx().unwrap().as_rule_context().unwrap()};
<else>
unsafe { <self()>.ctx_mut().unwrap().set_alt_number(<currentOuterMostAltCodeBlock.alt.altNum>); }
<endif>
<CodeBlockForAlt(currentAltCodeBlock=currentOuterMostAltCodeBlock, ...)>
>>

CodeBlockForAlt(currentAltCodeBlock, locals, preamble, ops) ::= <<
{
<locals; separator="\n">
<preamble; separator="\n">
<ops; separator="\n">
}
>>

LL1AltBlock(choice, preamble, alts, error) ::= <<
<self()>.base.set_state(<choice.stateNumber>);
<self()>.err_handler.sync(&mut <self()>.base)?;
<if(choice.label)><labelref(choice.label,{ = <self()>.base.input.lt(1).map(|t| t as _);})><endif>
<preamble; separator="\n">
match <self()>.base.input.la(1) {
    <choice.altLook,alts:{look,alt| <cases(tokens=look)> => {
    <alt>\}}; separator="\n">
	_ => Err(<error>)?
}
>>

LL1OptionalBlock(choice, alts, error) ::= <<
<self()>.base.set_state(<choice.stateNumber>);
<self()>.err_handler.sync(&mut <self()>.base)?;
match <self()>.base.input.la(1) {
<choice.altLook,alts:{look,alt| <cases(tokens=look)>
	=> {
    	<alt>
    \}}; separator="\n">
	_ => {}
}
>>

LL1OptionalBlockSingleAlt(choice, expr, alts, preamble, error, followExpr) ::= <<
<self()>.base.set_state(<choice.stateNumber>);
<self()>.err_handler.sync(&mut <self()>.base)?;
<preamble; separator="\n">
if <expr> {
	<alts; separator="\n">
}
<!else if ( !(<followExpr>) ) <error>!>
>>

LL1StarBlockSingleAlt(choice, loopExpr, alts, preamble, iteration) ::= <<
<self()>.base.set_state(<choice.stateNumber>);
<self()>.err_handler.sync(&mut <self()>.base)?;
<preamble; separator="\n">
while <loopExpr> {
	<alts; separator="\n">
	<self()>.base.set_state(<choice.loopBackStateNumber>);
	<self()>.err_handler.sync(&mut <self()>.base)?;
	<iteration>
}
>>

LL1PlusBlockSingleAlt(choice, loopExpr, alts, preamble, iteration) ::= <<
<self()>.base.set_state(<choice.blockStartStateNumber>); <! alt block decision !>
<self()>.err_handler.sync(&mut <self()>.base)?;
<preamble; separator="\n">
loop {
	<alts; separator="\n">
	<self()>.base.set_state(<choice.stateNumber>); <! loopback/exit decision !>
	<self()>.err_handler.sync(&mut <self()>.base)?;
	<iteration>
	if !(<loopExpr>) {break}
}
>>

// LL(*) stuff

AltBlock(choice, preamble, alts, error) ::= <<
<self()>.base.set_state(<choice.stateNumber>);
<self()>.err_handler.sync(&mut <self()>.base)?;
<if(choice.label)><labelref(choice.label,{ = <self()>.base.input.lt(1).map(|t| t as _);})><endif>
<preamble; separator="\n">
match <self()>.get_interpreter().adaptive_predict(<choice.decision>,&mut <self()>.base)? {
<alts:{alt |
	<i> =>{
		<alt>
	\}
	}; separator=",\n">
	_ => {}
}
>>

OptionalBlock(choice, alts, error) ::= <<
<self()>.base.set_state(<choice.stateNumber>);
<self()>.err_handler.sync(&mut <self()>.base)?;
match <self()>.get_interpreter().adaptive_predict(<choice.decision>,&mut <self()>.base)? {
<alts:{alt |
	x if x == <i><if(!choice.ast.greedy)>+1<endif>=>{
		<alt>
	\}
	}; separator="\n">
	_ => {}
}
>>

StarBlock(choice, alts, sync, iteration) ::= <<
<self()>.base.set_state(<choice.stateNumber>);
<self()>.err_handler.sync(&mut <self()>.base)?;
_alt = <self()>.get_interpreter().adaptive_predict(<choice.decision>,&mut <self()>.base)?;
while { _alt!=<choice.exitAlt> && _alt!=INVALID_ALT } {
	if _alt==1<if(!choice.ast.greedy)>+1<endif> {
		<iteration>
		<alts> <! should only be one !>
	}
	<self()>.base.set_state(<choice.loopBackStateNumber>);
	<self()>.err_handler.sync(&mut <self()>.base)?;
	_alt = <self()>.get_interpreter().adaptive_predict(<choice.decision>,&mut <self()>.base)?;
}
>>

PlusBlock(choice, alts, error) ::= <<
<self()>.base.set_state(<choice.blockStartStateNumber>); <! alt block decision !>
<self()>.err_handler.sync(&mut <self()>.base)?;
_alt = 1<if(!choice.ast.greedy)>+1<endif>;
loop {
	match _alt {
	<alts:{alt|
    x if x == <i><if(!choice.ast.greedy)>+1<endif>=>
	<alt>
	}; separator=",\n">
	_ => Err(<error>)?
	}
	<self()>.base.set_state(<choice.loopBackStateNumber>); <! loopback/exit decision !>
	<self()>.err_handler.sync(&mut <self()>.base)?;
	_alt = <self()>.get_interpreter().adaptive_predict(<choice.decision>,&mut <self()>.base)?;
	if _alt==<choice.exitAlt> || _alt==INVALID_ALT { break }
}
>>

Sync(s) ::= "<self()>.err_handler.sync(<s.expecting.escapedName>)?;"

ThrowNoViableAlt(t) ::= "ANTLRError::no_alt(&mut <self()>.base)"

TestSetInline(s) ::= <<
<s.bitsets:{bits | <if(rest(rest(bits.tokens)))><bitsetBitfieldComparison(s, bits)><else><bitsetInlineComparison(s, bits)><endif>}; separator=" || ">
>>

// Java language spec 15.19 - shift operators mask operands rather than overflow to 0... need range test
testShiftInRange(shiftAmount) ::= <<
((<shiftAmount>) & !0x3f) == 0
>>

// produces smaller bytecode only when bits.tokens contains more than two items
bitsetBitfieldComparison(s, bits) ::= <%
(<testShiftInRange({<offsetShift(s.varName, bits.shift)>})> && ((1usize \<\< <offsetShift(s.varName, bits.shift)>) & <bits.calculated>) != 0)
%>

isZero ::= [
"0":true,
default:false
]

offsetShift(shiftAmount, offset) ::= <%
<if(!isZero.(offset))>(<shiftAmount> - <offset>)<else><shiftAmount><endif>
%>

// produces more efficient bytecode when bits.tokens contains at most two items
bitsetInlineComparison(s, bits) ::= <%
<bits.tokens:{ttype | <s.varName>==<parser.grammarName>_<ttype.name>}; separator=" || ">
%>

cases(tokens) ::= <<
<tokens:{t | <parser.grammarName>_<t.name> }; separator="|",wrap>
>>

InvokeRule(r, argExprsChunks) ::= <<
/*InvokeRule <r.escapedName>*/
<self()>.base.set_state(<r.stateNumber>);
<LabelsAssign(r.labels,{<self()>.<r.escapedName><if(r.ast.options.p)>_rec<endif>(<if(r.ast.options.p)><r.ast.options.p><if(argExprsChunks)>,<endif><endif><argExprsChunks>)?})>
>>

MatchToken(m) ::= <<
<self()>.base.set_state(<m.stateNumber>);
<LabelsAssign(m.labels,{<self()>.base.match_token(<parser.grammarName>_<m.escapedName>,&mut <self()>.err_handler)?})>
>>

LabelsAssign(labels,assign) ::= <<
<if(labels)>
let tmp = <assign>;
<labels:{l | <ctx_mut_action(l,{.<l.escapedName> = Some(tmp);})> };separator="\n"><else><assign>;<endif>
>>

MatchSet(m, expr, capture) ::= "<CommonSetStuff(m, expr, capture, false)>"

MatchNotSet(m, expr, capture) ::= "<CommonSetStuff(m, expr, capture, true)>"

CommonSetStuff(m, expr, capture, invert) ::= <<
<self()>.base.set_state(<m.stateNumber>);
<if(m.labels)><m.labels:{l | <labelref(l,{ = <self()>.base.input.lt(1).map(|t| t as _);})>};separator="\n"><endif>
<capture>
if { <if(invert)><m.varName> \<= 0 || <else>!<endif>(<expr>) } {
	<LabelsAssign(m.labels,{<self()>.err_handler.recover_inline(&mut <self()>.base)?})>
}
else {
	if <self()>.base.input.la(1)==TOKEN_EOF { <self()>.base.matched_eof = true };
	<self()>.err_handler.report_match(&mut <self()>.base);
	<self()>.base.consume(&mut <self()>.err_handler)?;
}
>>

Wildcard(w) ::= <<
<self()>.base.set_state(<w.stateNumber>);
<LabelsAssign(w.labels,{<self()>.base.match_wildcard(&mut <self()>.err_handler)?})>
>>

// ACTION STUFF

Action(a, foo, chunks) ::= "<chunks>"

ArgAction(a, chunks) ::= "<chunks>"

SemPred(p, chunks, failChunks) ::= <<
<self()>.base.set_state(<p.stateNumber>);
<! its a hack to handle chunks being same here and in *_sempred() !>
if !({<chunks>}) {
	Err(ANTLRError::failed_predicate(&mut <self()>.base, Some(<p.predicate>.to_owned())<if(failChunks)>, Some(<failChunks>.to_owned())<elseif(p.msg)>, Some(<p.msg>.to_owned())<else>, None<endif>))?;
}
>>

ExceptionClause(e, catchArg, catchAction) ::= <<
Err(<catchArg>) => {<catchAction>}
>>

// lexer actions are not associated with model objects

LexerSkipCommand()  ::= "skip();"
LexerMoreCommand()  ::= "more();"
LexerPopModeCommand() ::= "pop_mode();"

LexerTypeCommand(arg, grammar)      ::= "_type = <arg>;"
LexerChannelCommand(arg, grammar)   ::= "_channel = <arg>;"
LexerModeCommand(arg, grammar)      ::= "_mode = <arg>;"
LexerPushModeCommand(arg, grammar)  ::= "push_mode(<arg>);"

ActionText(t) ::= "<t.text>"
ActionTemplate(t) ::= "<t.st>"
ArgRef(a) ::= "*<ctx(a)>.get_<a.escapedName>()"
LocalRef(a) ::= "*<ctx(a)>.get_<a.escapedName>()"
RetValueRef(a) ::= "*<ctx(a)>.get_<a.escapedName>()"
QRetValueRef(a) ::= "<ctx(a)>.<a.dict>.as_ref().unwrap().get_<a.escapedName>()"
/** How to translate $tokenLabel */
TokenRef(t) ::= "<ctx(t)>.<t.name>.as_ref()"
LabelRef(t) ::= "<ctx(t)>.<t.name>.as_ref().unwrap()"
ListLabelRef(t) ::= "<ctx(t)>.<ListLabelName(t.escapedName)>"
SetAttr(s,rhsChunks) ::= <<
let tmp = {<rhsChunks>}.to_owned();
<ctx_mut_action(s,{.set_<s.escapedName>(tmp);})>
>>

TokenLabelType() ::= << &'arena dyn Token >>
InputSymbolType() ::= "<file.InputSymbolType; null={OwningToken}>"

TokenPropertyRef_text(t) ::= << if let Some(it) = &<ctx(t)>.<t.label> { it.get_text() } else { "null" } >>
TokenPropertyRef_type(t) ::= << if let Some(it) = &<ctx(t)>.<t.label> { it.get_token_type() } else { 0 } >>
TokenPropertyRef_line(t) ::= << if let Some(it) = &<ctx(t)>.<t.label> { it.get_line() } else { 0 } >>
TokenPropertyRef_pos(t) ::=  << if let Some(it) = &<ctx(t)>.<t.label> { it.get_column() } else { 0 } >>
TokenPropertyRef_channel(t) ::= << if let Some(it) = &<ctx(t)>.<t.label> { it.get_chanel() } else { 0 } >>
TokenPropertyRef_index(t) ::= << if let Some(it) = &<ctx(t)>.<t.label> { it.get_token_index() } else { 0 } >>
TokenPropertyRef_int(t) ::= << if let Some(it) = &<ctx(t)>.<t.label> { i32::from_str_radix(it.get_text(),10).unwrap() } else { 0 } >>

RulePropertyRef_start(r) ::= << <ctx(r)>.<r.label>.as_ref().map(|it| it.start()) >>
RulePropertyRef_stop(r)	 ::= << <ctx(r)>.<r.label>.as_ref().map(|it| it.stop()) >>
RulePropertyRef_text(r)	 ::= <<(<ctx(r)>.<r.label>.as_ref().map(|it| <self()>.input.get_text_from_interval(it.start().get_token_index(),it.stop().get_token_index())).unwrap_or("null".to_owned()) )>>
RulePropertyRef_ctx(r)	 ::= << <ctx(r)>.<r.label>.as_ref().unwrap() >>
RulePropertyRef_parser(r)	 ::= "<self()>"

ThisRulePropertyRef_start(r) ::= "<self()>.ctx().unwrap().start()"
ThisRulePropertyRef_stop(r)	 ::= "<self()>.ctx().unwrap().stop()"
ThisRulePropertyRef_text(r)	 ::= <%
{let temp = <self()>.base.input.lt(-1).map(|it|it.get_token_index()).unwrap_or(-1); <self()>.input.get_text_from_interval(<self()>.ctx().unwrap().start().get_token_index(), temp)}
%>
ThisRulePropertyRef_ctx(r)	 ::= "_local_ctx_fn(<self()>)"
ThisRulePropertyRef_parser(r)	 ::= "<self()>"

// not self because we need to access parser from sempred functions where it is a fn parameter so it can't be self
self() ::= "recog"

NonLocalAttrRef(s)		 ::= "((\<s.ruleName; format=\"cap\">Context)getInvokingContext(<s.ruleIndex>)).<s.escapedName>"
SetNonLocalAttr(s, rhsChunks)	  ::=
	"((<s.ruleName; format=\"cap\">Context)getInvokingContext(<s.ruleIndex>)).<s.escapedName> = <rhsChunks>;"

AddToLabelList(a) ::= <<
let temp = <labelref(a.label,{.clone().unwrap()})>;
<ctx_mut_action(a.label,{.<a.listName>.push(temp);})> >>

TokenDecl(t) ::= << <t.escapedName>: Option\<<RustTypeMap.(TokenLabelType())>\>>>
TokenTypeDecl(t) ::= "let mut <t.name>: i32 = -1;"
TokenListDecl(t) ::= << <t.escapedName>:Vec\<<TokenLabelType()>\>>>
RuleContextDecl(r) ::= << <r.escapedName>: Option\<&'arena <r.ctxName>All\<'input, 'arena, Tok>\>>>
RuleContextListDecl(rdecl) ::= << <rdecl.escapedName>:Vec\<&'arena <rdecl.ctxName>All\<'input, 'arena, Tok>\>>>

ContextTokenGetterDecl(t)      ::= <<
/// Retrieves first TerminalNode corresponding to token <t.name>
/// Returns `None` if there is no child corresponding to token <t.name>
fn <t.name>(&self) -> Option\<&TerminalNode\<'input, 'arena, Tok\>\><if(t.signature)>;<else> {
    self.children_of_type::\<TerminalNode\<Tok\>\>().into_iter().find(|child| child.symbol.get_token_type() == <parser.grammarName>_<t.name>)
}<endif>
>>
ContextTokenListGetterDecl(t)  ::=<<
/// Retrieves all `TerminalNode`s corresponding to token <t.name> in current rule
fn <t.name>_all(&self) -> Vec\<&TerminalNode\<'input, 'arena, Tok\>\><if(t.signature)>;<else> {
	self.children_of_type::\<TerminalNode\<Tok\>\>().into_iter().filter(|child| child.symbol.get_token_type() == <parser.grammarName>_<t.name>).collect()
}<endif>
>>
ContextTokenListIndexedGetterDecl(t)  ::= <<
/// Retrieves 'i'th TerminalNode corresponding to token <t.name>, starting from 0.
/// Returns `None` if number of children corresponding to token <t.name> is less than or equal to `i`.
fn <t.name>(&self, i: usize) -> Option\<&TerminalNode\<'input, 'arena, Tok\>\><if(t.signature)>;<else> {
	self.children_of_type::\<TerminalNode\<Tok\>\>().into_iter().filter(|child| child.symbol.get_token_type() == <parser.grammarName>_<t.name>).nth(i)
}<endif>
>>
ContextRuleGetterDecl(r)       ::= <<
fn <r.escapedName>(&self) -> Option\<&'arena <r.ctxName>All\<'input, 'arena, Tok\>\><if(r.signature)>;<else> {
    self.child_of_type(0)
}<endif>
>>
ContextRuleListGetterDecl(r)   ::= <<
fn <r.name>_all(&self) -> Vec\<&'arena <r.ctxName>All\<'input, 'arena, Tok\>\><if(r.signature)>;<else> {
    self.children_of_type()
}<endif>
>>
ContextRuleListIndexedGetterDecl(r)   ::= <<
fn <r.escapedName>(&self, i: usize) -> Option\<&'arena <r.ctxName>All\<'input, 'arena, Tok\>\><if(r.signature)>;<else> {
    self.child_of_type(i)
}<endif>
>>

LexerRuleContext() ::= "LexerContext"

/** The rule context name is the rule followed by a suffix; e.g.,
 *	r becomes rContext.
 */
RuleContextNameSuffix() ::= "Context"

ImplicitTokenLabel(tokenName) ::= "<tokenName>"
ImplicitRuleLabel(ruleName)	  ::= "<ruleName>"
ImplicitSetLabel(id)		  ::= "_tset<id>"
ListLabelName(label)		  ::= "<label>"

CaptureNextToken(d) ::= "<d.varName> = <self()>.base.input.lt(1).unwrap();"
CaptureNextTokenType(d) ::= "<d.varName> = <self()>.base.input.la(1);"

StructDecl(struct,ctorAttrs,attrs,getters,dispatchMethods,interfaces,extensionMembers,signatures) ::= <<
pub type <struct.escapedName>\<'input, 'arena, Tok = CommonToken\<'input>\> = <if(contextSuperClass)><contextSuperClass><else>BaseParserRuleContext<endif>\<'input, 'arena, <struct.escapedName>Ext\<'input, 'arena, Tok\>, <parser.name>NodeKind, Tok\>;
<if(file.genVisitor && !struct.provideCopyFrom)>dbt_antlr4::impl_visitable! { <parser.grammarName>Visitor::<struct.escapedName>(visit_<struct.derivedFromName>) }<endif>
#[derive(Debug)]
pub struct <struct.escapedName>Ext\<'input: 'arena, 'arena, Tok: Token + 'input = CommonToken\<'input\>\> {
	<attrs:{a | pub <a>,}; separator="\n">
    ph: PhantomData\<(&'arena (), &'input Tok)\>,
}

impl\<'input: 'arena, 'arena, Tok> CustomRuleContext\<'input, 'arena, Tok> for <struct.escapedName>Ext\<'input, 'arena, Tok>
where
    Tok: Token + 'input,
{
	type NodeKind = <parser.name>NodeKind;
    fn node_tag() -> <parser.name>NodeKind { <parser.name>NodeKind::<struct.derivedFromName; format="cap">Context }
	fn get_rule_index(&self) -> usize { RULE_<struct.derivedFromName> }
    fn make_node(
        arena: &'arena Arena,
        ctx: <struct.escapedName>\<'input, 'arena, Tok\>,
    ) -> *mut <parser.name>Node\<'input, 'arena, Tok\> {
<if(struct.provideCopyFrom)>
        arena.alloc_labeled_node(<struct.escapedName>All::Error(ctx))
<else>
        arena.alloc_zeroed_node(ctx)<endif>
    }
    fn cast_from\<'a>(
        node: &'a <parser.name>Node\<'input, 'arena, Tok\>,
    ) -> Option\<&'a <struct.escapedName>\<'input, 'arena, Tok\>\> {
        if node.node_tag() == \<Self as CustomRuleContext\<'input, 'arena, Tok>\>::node_tag() {
            Some(dbt_antlr4::cast_unchecked!(node.ctx_ptr() => <struct.escapedName>\<'input, 'arena, Tok\>))
        } else {
            None
        }
    }
    fn cast_from_mut\<'a>(
        node: &'a mut <parser.name>Node\<'input, 'arena, Tok\>,
    ) -> Option\<&'a mut <struct.escapedName>\<'input, 'arena, Tok\>\> {
        if node.node_tag() == \<Self as CustomRuleContext\<'input, 'arena, Tok>\>::node_tag() {
            Some(dbt_antlr4::cast_unchecked!(node.ctx_ptr() => mut <struct.escapedName>\<'input, 'arena, Tok\>))
        } else {
            None
        }
    }
}

impl\<'input: 'arena, 'arena, Tok: Token + 'input> <struct.escapedName>Ext\<'input, 'arena, Tok>{
	fn create(arena: &'arena Arena, parent: Option\<&'arena <parser.name>Node\<'input, 'arena, Tok\>\>, invoking_state: i32<ctorAttrs:{a | , <a>}>) -> Result\<&'arena mut <parser.name>Node\<'input, 'arena, Tok>, ANTLRError\>
    {
		<struct.attributeDecls:{a | let mut _init_<a.escapedName> = <rustTypeInitMap.(a.type)>;
		 }>
		 <struct.ctorAttrs:{a | _init_<a.escapedName> = <a.escapedName>;
		 }>
        <if(contextSuperClass)><contextSuperClass><else>BaseParserRuleContext<endif>::create(arena, parent, invoking_state, <struct.escapedName>Ext {
			<!<attrs:{a | <a.escapedName>:None,}>!>
				<struct.tokenDecls:{a | <a.escapedName>: None, }>
				<struct.tokenTypeDecls:{a | <a.escapedName>: -1, }>
				<struct.tokenListDecls:{a | <a.escapedName>: Vec::new(), }>
				<struct.ruleContextDecls:{a | <a.escapedName>: None, }>
				<struct.attributeDecls:{a | <a.escapedName>: _init_<a.escapedName>, }>
				<struct.ruleContextListDecls:{a | <a.escapedName>: Vec::new(), }>
				ph: PhantomData
			}
		)
	}
}

pub trait <struct.escapedName>Attrs\<'input, 'arena, Tok>: ParserRuleContext\<'input, 'arena>
where
    'input: 'arena,
    Tok: Token + 'input,
{
    <struct.attributeDecls:{a | fn get_<a.escapedName>(&self) -> &<RustTypeMap.(a.type)>; }; separator = "\n">
    <struct.attributeDecls:{a | fn set_<a.escapedName>(&mut self,attr: <RustTypeMap.(a.type)>); }; separator = "\n">
    <signatures:{s | <s>}; separator="\n">
    <extensionMembers; separator="\n">
}

impl\<'input, 'arena, Tok: Token + 'input> <struct.escapedName>Attrs\<'input, 'arena, Tok> for <struct.escapedName>\<'input, 'arena, Tok>
where
    'input: 'arena,
{
    <struct.attributeDecls:{a | fn get_<a.escapedName>(&self) -> &<RustTypeMap.(a.type)> { &self.deref().<a.escapedName> \}  }; separator = "\n">
    <struct.attributeDecls:{a | fn set_<a.escapedName>(&mut self,attr: <RustTypeMap.(a.type)>) { self.deref_mut().<a.escapedName> = attr; \}  }; separator = "\n">
    <getters:{g | <g>}; separator="\n">
    <extensionMembers; separator="\n">
}
>>

AltLabelStructDecl(struct,attrs,getters,dispatchMethods,signatures) ::= <<

pub type <struct.escapedName>\<'input, 'arena, Tok = CommonToken\<'input\>\> = <if(contextSuperClass)><contextSuperClass><else>BaseParserRuleContext<endif>\<'input, 'arena, <struct.escapedName>Ext\<'input, 'arena, Tok\>, <parser.name>NodeKind, Tok\>;

pub trait <struct.escapedName>Attrs\<'input, 'arena, Tok>: ParserRuleContext\<'input, 'arena>
where
    'input: 'arena,
    Tok: Token + 'input,
{
	<signatures:{s | <s>}; separator="\n">
}

impl\<'input: 'arena, 'arena, Tok: Token + 'input> <struct.escapedName>Attrs\<'input, 'arena, Tok> for <struct.escapedName>\<'input, 'arena, Tok>
{
    <getters:{g | <g>}; separator="\n">
}
#[derive(Debug)]
pub struct <struct.escapedName>Ext\<'input: 'arena, 'arena, Tok: Token + 'input = CommonToken\<'input\>\> {
	base: <currentRule.name; format="cap">ContextExt\<'input, 'arena, Tok>,
	<attrs:{a | pub <a>,}; separator="\n">
    pd: PhantomData\<(&'arena (), &'input Tok)\>
}

impl\<'input: 'arena, 'arena, Tok: Token + 'input> CustomRuleContext\<'input, 'arena, Tok> for <struct.escapedName>Ext\<'input, 'arena, Tok>
{
	type NodeKind = <parser.name>NodeKind;
    fn node_tag() -> <parser.name>NodeKind { <parser.name>NodeKind::<currentRule.name; format="cap">Context }
	fn get_rule_index(&self) -> usize { RULE_<currentRule.name> }
    fn make_node(
        arena: &'arena Arena,
        ctx: <struct.escapedName>\<'input, 'arena, Tok>,
    ) -> *mut <parser.name>Node\<'input, 'arena, Tok> {
        arena.alloc_labeled_node(<currentRule.name; format="cap">ContextAll::<struct.escapedName>(ctx))
    }
    fn cast_from\<'a>(
        node: &'a <parser.name>Node\<'input, 'arena, Tok>,
    ) -> Option\<&'a <struct.escapedName>\<'input, 'arena, Tok\>\> {
        if node.node_tag() == \<Self as CustomRuleContext\<'input, 'arena, Tok>\>::node_tag() {
            match dbt_antlr4::cast_unchecked!(node => <currentRule.name; format="cap">ContextAll\<'input, 'arena, Tok\>) {
                <currentRule.name; format="cap">ContextAll::<struct.escapedName>(ctx) => Some(ctx),
                _ => None
            }
        } else {
            None
        }
    }
    fn cast_from_mut\<'a>(
        node: &'a mut <parser.name>Node\<'input, 'arena, Tok>,
    ) -> Option\<&'a mut <struct.escapedName>\<'input, 'arena, Tok\>\> {
        if node.node_tag() == \<Self as CustomRuleContext\<'input, 'arena, Tok>\>::node_tag() {
            match dbt_antlr4::cast_unchecked!(node => mut <currentRule.name; format="cap">ContextAll\<'input, 'arena, Tok\>) {
                <currentRule.name; format="cap">ContextAll::<struct.escapedName>(ctx) => Some(ctx),
                _ => None
            }
        } else {
            None
        }
    }
}

impl\<'input, 'arena, Tok> <currentRule.name; format="cap">ContextAttrs\<'input, 'arena, Tok> for <struct.escapedName>\<'input, 'arena, Tok>
where
    'input: 'arena,
    Tok: Token + 'input,
{
    <currentRule.ruleCtx.attributeDecls:{a | fn get_<a.escapedName>(&self) -> &<RustTypeMap.(a.type)> { &self.deref().base.<a.escapedName> \}  }; separator = "\n">
    <currentRule.ruleCtx.attributeDecls:{a | fn set_<a.escapedName>(&mut self,attr: <RustTypeMap.(a.type)>) { self.deref_mut().base.<a.escapedName> = attr; \}  }; separator = "\n">
}

impl\<'input: 'arena, 'arena, Tok: Token + 'input> <struct.escapedName>Ext\<'input, 'arena, Tok> {
	fn new(base: <currentRule.name; format="cap">ContextExt\<'input, 'arena, Tok>) -> Self {
        Self {
            base,
            <struct.tokenDecls:{a | <a.escapedName>:None, }>
            <struct.tokenTypeDecls:{a | <a.escapedName>:-1, }>
            <struct.tokenListDecls:{a | <a.escapedName>:Vec::new(), }>
            <struct.ruleContextDecls:{a | <a.escapedName>:None, }>
            <struct.ruleContextListDecls:{a | <a.escapedName>:Vec::new(), }>
            pd: PhantomData
        }
    }

	fn copy_from(src: &mut <parser.name>Node\<'input, 'arena, Tok>) {
        let invoking_state = src.get_invoking_state();
        let ctx = {
            let Some(base_ctx): Option\<&mut <currentRule.name; format="cap">Context\<'input, 'arena, Tok>\> = src.as_rule_context_mut() else {
                panic!("invalid node type for copy_from!");
            };
            let tmp = unsafe { std::ptr::read(base_ctx) };
            <currentRule.name; format="cap">ContextAll::<struct.escapedName>(tmp.morph(|ext_src| Self::new(ext_src)))
        };
        *dbt_antlr4::cast_unchecked!(src => mut <currentRule.name; format="cap">ContextAll\<'input, 'arena, Tok\>) = ctx;
        src.set_invoking_state(invoking_state);
        src.node_tag = \<Self as CustomRuleContext\<'input, 'arena, Tok>\>::node_tag();
	}
}
>>

ListenerDispatchMethod(method) ::= <<
fn <if(method.isEnter)>enter<else>exit<endif>(&self,listener: &mut (dyn <parser.grammarName>Listener\<'input> + 'a)) -> Result\<(), ANTLRError> {
	listener.<if(method.isEnter)>enter<else>exit<endif>_<struct.derivedFromName>(self);
	Ok(())
}
>>

VisitorDispatchMethod(method) ::= <<
fn accept(&self,visitor: &mut (dyn <parser.grammarName>Visitor\<'input> + 'a)) {
	visitor.visit_<struct.derivedFromName>(self);
}
>>
decAttributeDecl(d) ::= "<d.escapedName>: <d.type><if(d.initValue)> = <d.initValue><endif>"
AttributeDecl(d) ::= "<d.escapedName>: <RustTypeMap.(d.type)>"
AttributeDeclInit(d) ::= "<d.escapedName>: <RustTypeMap.(d.type)>"
/** If we don't know location of label def x, use this template */
labelref(x,action) ::= "<if(!x.isLocal)><ctx_mut_action(x,{.<x.escapedName><action>})><else><x.escapedName><action><endif>"

/** For any action chunk, what is correctly-typed context struct ptr? */
ctx(actionChunk) ::= <<<self()>.ctx().unwrap().as_rule_context::\<<actionChunk.ctx.escapedName>\<TF::Tok>\>().unwrap()>>
ctx_action(actionChunk,actionText) ::= << <self()>.ctx().unwrap().as_rule_context::\<<actionChunk.ctx.escapedName>\<TF::Tok>\>().unwrap()<actionText> >>
ctx_mut_action(actionChunk,actionText) ::= <<unsafe { <self()>.ctx_mut().unwrap().as_rule_context_mut::\<<actionChunk.ctx.escapedName>\<TF::Tok>\>().unwrap()<actionText> }>>

// used for left-recursive rules
recRuleAltPredicate(ruleName,opPrec)  ::= "recog.precpred(None<!todo proper ctx?!>, <opPrec>)"
recRuleSetReturnAction(src,name)	  ::= "$<name>/*a*/=$<src>.<name>; /* here?*/"
recRuleSetStopToken()                 ::= <<
let tmp = <self()>.input.lt(-1);
<self()>.base.with_mut_ctx(|ctx| { ctx.set_stop(tmp.map(|t| t as _)); });
>>

recRuleAltStartAction(ruleName, ctxName, label, isListLabel) ::= <<
/*recRuleAltStartAction*/
let tmp = <ctxName>ContextExt::create(<self()>.get_arena(), _parentctx, _parentState)?;
let _prevctx = <self()>.push_new_recursion_context(tmp.into(), _startState, RULE_<ruleName>)?;
<if(label)>
<self()>.base.with_mut_ctx(|ctx| {
<if(isListLabel)>
ctx.as_rule_context_mut::\<<ctxName>Context\<TF::Tok>\>().unwrap().<label>.push(_prevctx.as_rule_context().unwrap());
<else>
ctx.as_rule_context_mut::\<<ctxName>Context\<TF::Tok>\>().unwrap().<label> = Some(_prevctx.as_rule_context().unwrap());
<endif>
});
<endif>
>>

recRuleLabeledAltStartAction(ruleName, currentAltLabel, label, isListLabel) ::= <<
/*recRuleLabeledAltStartAction*/
let tmp = <ruleName; format="cap">ContextExt::create(<self()>.get_arena(), _parentctx, _parentState)?;
<currentAltLabel; format="cap">ContextExt::copy_from(tmp);
let _prevctx = <self()>.push_new_recursion_context(tmp, _startState, RULE_<ruleName>)?;
let _local_ctx_fn = |recog: &Self| -> &'arena <currentAltLabel; format="cap">Context\<TF::Tok> {recog.ctx().unwrap().as_rule_context().unwrap()};
<if(label)>
<self()>.base.with_mut_ctx(|ctx| {
<if(isListLabel)>
ctx.as_rule_context_mut::\<<currentAltLabel; format="cap">Context\<TF::Tok>\>().unwrap().<label>.push(_prevctx.as_rule_context().unwrap());
<else>
ctx.as_rule_context_mut::\<<currentAltLabel; format="cap">Context\<TF::Tok>\>().unwrap().<label> = Some(_prevctx.as_rule_context().unwrap());
<endif>
});
<endif>
>>

recRuleReplaceContext(ctxName) ::= <<
<self()>.base.with_mut_ctx(|ctx| { <ctxName>ContextExt::copy_from(ctx); });
let _local_ctx_fn = |recog: &Self| -> &'arena <ctxName>Context\<TF::Tok> {recog.ctx().unwrap().as_rule_context().unwrap()};
>>

recRuleSetPrevCtx() ::= <<
<self()>.trigger_exit_rule_event()?;
>>


LexerFile(lexerFile, lexer, namedActions) ::= <<
<fileHeader(lexerFile.grammarFileName, lexerFile.ANTLRVersion)>
#![allow(dead_code)]
#![allow(unused_imports)]
#![allow(nonstandard_style)]
#![allow(unused_variables)]
#![allow(unused_braces)]
#![allow(unused_parens)]
<namedActions.header>
use dbt_antlr4::Arena;
use dbt_antlr4::atn::ATN;
use dbt_antlr4::char_stream::CharStream;
use dbt_antlr4::int_stream::IntStream;
use dbt_antlr4::lexer::{BaseLexer, LexerRecog, Lexer as _};
use dbt_antlr4::atn_config_set::LexerATNConfigSet;
use dbt_antlr4::atn_deserializer::ATNDeserializer;
use dbt_antlr4::atn_simulator::BaseATNSimulator;
use dbt_antlr4::atn_simulator::LexerATNSimulatorManager as ATNSimulatorManager;
use dbt_antlr4::TokenSource;
use dbt_antlr4::lexer_atn_simulator::{LexerATNSimulator, ILexerATNSimulator};
use dbt_antlr4::PredictionContextCache;
use dbt_antlr4::recognizer::Actions;
use dbt_antlr4::token_factory::{CommonTokenFactory, TokenFactory};
use dbt_antlr4::rule_context::{BaseRuleContext,EmptyNodeKind,EmptyCustomRuleContext,EmptyRuleNode};
use dbt_antlr4::vocabulary::{Vocabulary,VocabularyImpl};

use std::ops::{DerefMut, Deref};
use std::sync::LazyLock;

<lexer>
>>

Lexer(lexer, atn, actionFuncs, sempredFuncs, superClass) ::= <<
dbt_antlr4::check_version!("1","3");
<if(lexer.tokens)>
<lexer.tokens:{k | pub const <k>:i32=<lexer.tokens.(k)>}; separator="; \n", wrap, anchor>;
<endif>

pub const channelNames: [&'static str;<length(lexer.channelNames)>+2] = [
    "DEFAULT_TOKEN_CHANNEL", "HIDDEN"<if (lexer.channelNames)>, <lexer.channelNames:{c| "<c>"}; separator=", ", wrap, anchor><endif>
];

pub const modeNames: [&'static str;<length(lexer.modes)>] = [
    <lexer.modes:{m| "<m>"}; separator=", ", wrap, anchor>
];

pub const ruleNames: [&'static str;<length(lexer.ruleNames)>] = [
    <lexer.ruleNames:{r | "<r>"}; separator=", ", wrap, anchor>
];
<vocabulary(lexer.literalNames, lexer.symbolicNames)>
<namedActions.definitions>

pub type LexerContext\<'input, 'arena> = BaseRuleContext\<'input, 'arena, EmptyNodeKind, EmptyCustomRuleContext\<'input, 'arena>\>;
pub type BaseLexerType\<'input, 'arena, Input, TF> = BaseLexer\<'input, 'arena, <lexer.name>Actions, Input, TF>;
pub fn lexer_simulator_manager() -> &'static ATNSimulatorManager { &ATN_SIMULATOR_MANAGER }

pub struct <lexer.name>\<'input, 'arena, Input, TF = CommonTokenFactory\<'input, 'arena\>\>
where
    'input: 'arena,
    TF: TokenFactory\<'input, 'arena\> + 'arena,
    Input: CharStream\<'input>,
{
	base: BaseLexerType\<'input, 'arena, Input, TF>,
}

dbt_antlr4::impl_token_source! { <lexer.name> }
dbt_antlr4::impl_deref! { lexer => <lexer.name> }

impl\<'input, 'arena, Input, TF> <lexer.name>\<'input, 'arena, Input, TF>
where
    'input: 'arena,
    TF: TokenFactory\<'input, 'arena\> + 'arena,
    Input: CharStream\<'input>,
{
    pub fn new(arena: &'arena Arena, input: Input) -> Self {
        let actions = <lexer.name>Actions {
            <namedActions.init>
        };
        let base = BaseLexerType::new_base_lexer(input, actions, arena);
        Self { base }
    }
}

pub struct <lexer.name>Actions {
	<namedActions.fields>
}

impl <lexer.name>Actions {
	<namedActions.members>
<if(actionFuncs)>
	<actionFuncs.values; separator="\n">
<endif>
<if(sempredFuncs)>
	<sempredFuncs.values; separator="\n">
<endif>
}

impl\<'input, 'arena, Input, TF\> Actions\<'input, 'arena, BaseLexerType\<'input, 'arena, Input, TF\>, TF::Tok\>
    for <lexer.name>Actions
where
    'input: 'arena,
    Input: CharStream\<'input>,
    TF: TokenFactory\<'input, 'arena> + 'arena,
<if(actionFuncs || sempredFuncs)><dumpLexerActions(lexer, "", actionFuncs, sempredFuncs)>
<else> {}
<endif>

impl\<'input, 'arena, Input, TF\> LexerRecog\<'input, 'arena, TF, BaseLexerType\<'input, 'arena, Input, TF\>\>
    for <lexer.name>Actions
where
    'input: 'arena,
    Input: CharStream\<'input>,
    TF: TokenFactory\<'input, 'arena> + 'arena,
{
	<namedActions.extend>
    fn get_rule_names(&self) -> &'static [&'static str] { &ruleNames }
    fn get_literal_names(&self) -> &[Option\<&str>] { &_LITERAL_NAMES }
    fn get_symbolic_names(&self) -> &[Option\<&str>] { &_SYMBOLIC_NAMES }
    fn get_grammar_file_name(&self) -> &'static str { "<lexer.name>.g4" }
    fn get_atn_simulator_man(&self) -> &'static ATNSimulatorManager { &ATN_SIMULATOR_MANAGER }
}

<atn>
>>

SerializedATN(model) ::= <<
static ATN_SIMULATOR_MANAGER: LazyLock\<ATNSimulatorManager> = LazyLock::new(|| ATNSimulatorManager::new(&_ATN));
static _ATN: LazyLock\<ATN> =
    LazyLock::new(|| ATNDeserializer::new(None).deserialize(&mut _serializedATN.iter()));
static _serializedATN: LazyLock\<Vec\<i32>\> = LazyLock::new(|| vec![
    <model.serialized; separator=", ", wrap>
]);
>>

/** Using a type to init value map, try to init a type; if not in table
 *	must be an object, default value is "null".
 */
initValue(typeName) ::= <<
<rustTypeInitMap.(typeName)>
>>

codeFileExtension() ::= ".rs"
