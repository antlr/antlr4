// unsupported
TreeNodeWithAltNumField(X) ::= <<
@parser::definitions {
struct MyRuleNode\<T:CustomRuleContext>(BaseParserRuleContext\<MyRuleNodeCtx\<T> >);
struct MyRuleNodeCtx\<T:CustomRuleContext>(T,std::cell::Cell\<isize>);
use core::fmt::{Formatter,Debug};
impl\<T:CustomRuleContext> Debug for MyRuleNode\<T>{
    fn fmt(&self, f: &mut Formatter) -> std::fmt::Result {
        f.write_str(std::any::type_name::\<Self>())
    }
}

impl\<T:CustomRuleContext> CustomRuleContext for MyRuleNodeCtx\<T>{
    fn get_alt_number(&self) -> isize {self.1.get()}
    fn set_alt_number(&self, _alt_number: isize) {self.1.set(_alt_number)}
}


impl\<T:CustomRuleContext> Deref for MyRuleNode\<T>{
	type Target = dyn ParserRuleContext;
	fn deref(&self) -> &Self::Target {&self.0}
}
impl\<T:CustomRuleContext> DerefMut for MyRuleNode\<T>{
	fn deref_mut(&mut self) -> &mut Self::Target { &mut self.0 }
}
impl\<T:CustomRuleContext> dbt_antlr4::parser_rule_context::DerefSeal for MyRuleNode\<T>{}
}
>>

PositionAdjustingLexer() ::= <<
>>

PositionAdjustingLexerDef() ::= <<
//@definitions
   fn handleAcceptPositionForIdentifier\<'input, 'arena, Input:CharStream\<'input>, TF: TokenFactory\<'input, 'arena> + 'arena\>(this: &mut BaseLexerType\<'input, 'arena, Input, TF>) {
     let tokenText = this.get_text();
     let identifierLength = tokenText.chars().position(|it| !isIdentifierChar(it)).unwrap() as isize;
//     while (identifierLength \< tokenText.len() as i32 && isIdentifierChar(tokenText[identifierLength as usize])) {
//       identifierLength+=1;
//     }

     if this.get_input_stream().unwrap().index() > this.token_start_char_index + identifierLength {
       let offset = (identifierLength - 1) as i32;
       let mut input = this.input.take().unwrap();
       this.interpreter.as_mut().unwrap().resetAcceptPosition(&mut input,
         this.token_start_char_index + offset as isize, this.token_start_line, this.token_start_column + offset);
       this.input = Some(input);
       //return;
     };

   }

   fn handleAcceptPositionForKeyword\<'input, 'arena, Input:CharStream\<'input>, TF: TokenFactory\<'input, 'arena> + 'arena\>(this: &mut BaseLexerType\<'input, 'arena, Input, TF>, keyword: &str) {
   	let mut input = this.input.take().unwrap();
     if input.index() > this.token_start_char_index + keyword.len() as isize {
       let offset = keyword.len() as i32 - 1;
       this.interpreter.as_mut().unwrap().resetAcceptPosition(&mut input,
         this.token_start_char_index + offset as isize, this.token_start_line, this.token_start_column + offset);
       //return true;
     }
     this.input = Some(input);

     //return false;
   }

   fn isIdentifierChar(c: char) -> bool{
     return c.is_ascii_alphanumeric() || c == '_';
   }

trait PositionAdjustingLexerATNSim {
    fn resetAcceptPosition(&mut self, input: &mut dyn IntStream, index: isize, line: u32, charPositionInLine: i32);
  }
impl\<'sim> PositionAdjustingLexerATNSim for dbt_antlr4::lexer_atn_simulator::LexerATNSimulator\<'sim>{
    fn resetAcceptPosition(&mut self, input: &mut dyn IntStream, index: isize, line: u32, charPositionInLine: i32) {
      input.seek(index);
      self.set_line(line);
      self.set_char_position_in_line(charPositionInLine);
      self.consume(input);
    }
}

}
@extend{

  fn before_emit(lexer:&mut BaseLexerType\<'input, 'arena, Input, TF>) {
    match (lexer.token_type) {
      TOKENS => handleAcceptPositionForKeyword(lexer,"tokens"),
      LABEL => handleAcceptPositionForIdentifier(lexer),
      _ => {}
    }
  }

>>


BasicListener(X) ::= <<
@parser::definitions {
struct TestListener;

impl\<'arena, Tok: Token + 'arena> ParseTreeListener\<'arena, TParserNodeKind, Tok\> for TestListener{
	fn visit_terminal(&mut self, node: &TerminalNode\<'_, 'arena, Tok> ) -> Result\<(), ANTLRError> {
		println!("{}", node.symbol.get_text());
		Ok(())
	}
}
impl\<'arena, Tok: Token + 'arena> TListener\<'arena, Tok> for TestListener {}
}
>>

WalkListener(s) ::= <<
TTreeWalker::walk(Box::new(TestListener), <s>.deref());
>>

TokenGetterListener(X) ::= <<
@parser::definitions {
use dbt_antlr4::tree::Tree;
struct TestListener;

impl\<'arena, Tok: Token + 'arena> TListener\<'arena, Tok> for TestListener
{
	fn exit_a\<'input: 'arena>(&mut self, node: &AContext\<'input, 'arena, Tok>) -> Result\<(), ANTLRError> {
		if node.get_child_count() == 2 {
			println!("{} {} {:?}",node.INT(0).unwrap().symbol.get_text(),node.INT(1).unwrap().symbol.get_text(),node.INT_all())
		} else {
			println!("{}",node.ID().unwrap().symbol);
		}
        Ok(())
	}
}
impl\<'arena, Tok: Token + 'arena> ParseTreeListener\<'arena, TParserNodeKind, Tok\> for TestListener {}
}
>>

RuleGetterListener(X) ::= <<
@parser::definitions {

use dbt_antlr4::tree::Tree;
struct TestListener;

impl\<'arena, Tok: Token + 'arena> TListener\<'arena, Tok> for TestListener
{
	fn exit_a\<'input: 'arena>(&mut self, node: &AContext\<'input, 'arena, Tok>) -> Result\<(), ANTLRError> {
		if node.get_child_count() == 2 {
			println!("{} {} {}",
				node.b(0).unwrap().start().get_text(),
				node.b(1).unwrap().start().get_text(),
				node.b_all()[0].start().get_text(),
			)
		} else{
			println!("{}",node.b(0).unwrap().start().get_text());
		}
        Ok(())
	}
}
impl\<'arena, Tok: Token + 'arena> ParseTreeListener\<'arena, TParserNodeKind, Tok\> for TestListener{}
}
>>


LRListener(X) ::= <<
@parser::definitions {
use dbt_antlr4::tree::Tree;
struct TestListener;

impl\<'arena, Tok: Token + 'arena> ParseTreeListener\<'arena, TParserNodeKind, Tok\> for TestListener{}
impl\<'arena, Tok: Token + 'arena> TListener\<'arena, Tok> for TestListener {
	fn exit_e\<'input: 'arena>(&mut self, ctx: &EContext\<'input,'arena, Tok>) -> Result\<(), ANTLRError> {
		if ctx.get_child_count() == 3 {
			println!("{} {} {}",ctx.e(0).unwrap().start().get_text(),ctx.e(1).unwrap().start().get_text(),ctx.e_all()[0].start().get_text());
		} else {
			println!("{}",ctx.INT().unwrap().symbol.get_text());
		}
        Ok(())
	}
}
}
>>

LRWithLabelsListener(X) ::= <<
@parser::definitions {
use dbt_antlr4::tree::Tree;

struct TestListener;

impl\<'arena, Tok: Token + 'arena> ParseTreeListener\<'arena, TParserNodeKind, Tok\> for TestListener{}
impl\<'arena, Tok: Token + 'arena> TListener\<'arena, Tok> for TestListener {
	fn exit_Call\<'input: 'arena>(&mut self, ctx: &CallContext\<'input,'arena, Tok>) -> Result\<(), ANTLRError> {
		println!("{} {}",ctx.e().unwrap().start().get_text(),ctx.eList().unwrap().to_string(None,None));
        Ok(())
	}
	fn exit_Int\<'input: 'arena>(&mut self, ctx: &IntContext\<'input,'arena, Tok>) -> Result\<(), ANTLRError> {
		println!("{}",ctx.INT().unwrap().symbol.get_text());
        Ok(())
	}
}
}
>>

