mod <lexerName; format="lower">;
use <lexerName; format="lower">::<lexerName>;
<if(parserName)>
mod <parserName; format="lower">;
use <parserName; format="lower">::<parserName>;
use <parserName; format="lower">::<grammarName>ParserNodeKind;
